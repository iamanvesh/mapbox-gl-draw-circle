# Copy to .env.local (ignored by git) and fill in what you need:
#   cp .env.example .env.local

# Mapbox access token, from https://account.mapbox.com/access-tokens/
# mapbox-gl v3 does not paint the map without one. Drawing still works, but the canvas stays blank.
# Not needed for VITE_MAP_ENGINE=maplibre.
VITE_MAPBOX_TOKEN=

# Map engine: mapbox (default) or maplibre. MapLibre needs no token; in `npm run dev` it uses
# OpenFreeMap's free streets basemap.
VITE_MAP_ENGINE=mapbox

# Optional basemap override: "blank" for the plain offline background, or any style URL.
# Leave empty for the default (Mapbox Streets with a token, OpenFreeMap on MapLibre in dev).
VITE_BASEMAP=
