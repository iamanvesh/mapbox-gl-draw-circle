{
  "name": "mapbox-gl-draw-circle",
  "version": "2.0.0",
  "description": "A module to draw a circle using mapbox-gl-draw",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./index.js",
  "types": "./index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "lib/",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage"
  },
  "keywords": [
    "mapbox",
    "mapbox-gl",
    "mapbox-gl-draw",
    "geojson",
    "circle",
    "draw"
  ],
  "author": "Anvesh Kumar Arrabochu",
  "license": "MIT",
  "peerDependencies": {
    "@mapbox/mapbox-gl-draw": ">=1.4.0",
    "@types/mapbox__mapbox-gl-draw": "*"
  },
  "peerDependenciesMeta": {
    "@types/mapbox__mapbox-gl-draw": {
      "optional": true
    }
  },
  "dependencies": {
    "@turf/circle": "^7.4.0",
    "@turf/distance": "^7.4.0",
    "@turf/helpers": "^7.4.0"
  },
  "devDependencies": {
    "@mapbox/mapbox-gl-draw": "1.5.2",
    "jest": "^30.5.2"
  },
  "jest": {
    "roots": [
      "<rootDir>/__tests__"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "testEnvironment": "node",
    "transform": {},
    "restoreMocks": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamanvesh/mapbox-gl-draw-circle"
  },
  "bugs": {
    "url": "https://github.com/iamanvesh/mapbox-gl-draw-circle/issues"
  },
  "homepage": "https://github.com/iamanvesh/mapbox-gl-draw-circle#readme"
}
